#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

show_banner() {
    clear
    echo -e "${CYAN}${BOLD}"
    echo "  =============================================="
    echo "  |                                            |"
    echo "  |        A R V A N E X                       |"
    echo "  |                                            |"
    echo "  |        Python Auto-Runner by Arvanex       |"
    echo "  |                                            |"
    echo "  =============================================="
    echo -e "${NC}"
}

if [ -z "$1" ]; then
    show_banner
    echo -e "${RED}${BOLD}[X] Error:${NC} No Python file specified."
    echo -e "${YELLOW}    Usage:${NC} arvanex <file.py>"
    echo -e "${YELLOW}    Example:${NC} arvanex app.py"
    echo ""
    exit 1
fi

SCRIPT_FILE="$1"

if [ ! -f "$SCRIPT_FILE" ]; then
    show_banner
    echo -e "${RED}${BOLD}[X] Error:${NC} File '$SCRIPT_FILE' not found."
    exit 1
fi

if ! command -v python3 &> /dev/null; then
    echo -e "${RED}[X] Python3 is not installed.${NC}"
    echo -e "${YELLOW}[*] Install with:${NC} sudo apt install python3 python3-pip"
    exit 1
fi

if ! command -v pip3 &> /dev/null; then
    echo -e "${YELLOW}[!] pip3 is not installed, installing...${NC}"
    sudo apt update && sudo apt install -y python3-pip
fi

show_banner

echo -e "${BLUE}${BOLD}[>] File:${NC} $SCRIPT_FILE"
echo -e "${BLUE}${BOLD}[>] Version:${NC} $(python3 --version)"
echo -e "${CYAN}----------------------------------------------${NC}"
echo ""

echo -e "${MAGENTA}${BOLD}[1/3]${NC} ${BOLD}Analyzing required modules...${NC}"

MODULES=$(grep -E '^\s*(import|from)\s+' "$SCRIPT_FILE" \
    | sed -E 's/^\s*from\s+([a-zA-Z0-9_]+).*/\1/; s/^\s*import\s+([a-zA-Z0-9_]+).*/\1/' \
    | cut -d'.' -f1 \
    | sort -u)

if [ -z "$MODULES" ]; then
    echo -e "${YELLOW}    [!] No modules found.${NC}"
else
    for MOD in $MODULES; do
        if python3 -c "import $MOD" 2>/dev/null; then
            echo -e "    ${GREEN}[OK]${NC} $MOD ${GREEN}(installed)${NC}"
        else
            echo -e "    ${YELLOW}[>>]${NC} $MOD ${YELLOW}(will be installed)${NC}"
            MISSING_LIBS="$MISSING_LIBS $MOD"
        fi
    done
fi

echo ""

if [ -n "$MISSING_LIBS" ]; then
    echo -e "${MAGENTA}${BOLD}[2/3]${NC} ${BOLD}Installing missing modules...${NC}"
    for LIB in $MISSING_LIBS; do
        echo -e "    ${CYAN}> Installing:${NC} $LIB"
        pip3 install --quiet "$LIB" 2>/dev/null
        if [ $? -eq 0 ]; then
            echo -e "    ${GREEN}[OK]${NC} $LIB installed successfully"
        else
            ALT=$(echo "$LIB" | tr 'A-Z' 'a-z')
            pip3 install --quiet "$ALT" 2>/dev/null
            if [ $? -eq 0 ]; then
                echo -e "    ${GREEN}[OK]${NC} $ALT installed successfully"
            else
                echo -e "    ${RED}[X]${NC} Failed to install $LIB"
            fi
        fi
    done
else
    echo -e "${MAGENTA}${BOLD}[2/3]${NC} ${GREEN}All modules are already installed.${NC}"
fi

echo ""

echo -e "${MAGENTA}${BOLD}[3/3]${NC} ${BOLD}Running script...${NC}"
echo -e "${CYAN}----------------------------------------------${NC}"
echo ""

python3 "$SCRIPT_FILE"
EXIT_CODE=$?

echo ""
echo -e "${CYAN}----------------------------------------------${NC}"
if [ $EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}${BOLD}[OK] Execution completed successfully.${NC}"
else
    echo -e "${RED}${BOLD}[X] Execution failed with exit code: $EXIT_CODE${NC}"
fi
echo -e "${CYAN}${BOLD}    Developed by Arvanex${NC}"
echo -e "${CYAN}----------------------------------------------${NC}"

exit $EXIT_CODE
